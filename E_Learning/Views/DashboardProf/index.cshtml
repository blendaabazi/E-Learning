@{
    ViewData["Title"] = "Dashboard Professor";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    @if (User.Identity.IsAuthenticated)
    {
        @* Sidebar import *@
        @await Html.PartialAsync("Sidebar")
        <div class="wrapper">
            <div class="main p-3" style="margin-left:50px; margin-top:-700px;">
                <div class="text-center">
                    <h1>@ViewData["Title"]</h1>
                </div>

                <!-- Display Lecture Counts in Chart -->
                <div id="lectureChartDisplay" class="mt-5 text-center">
                    <h3>Number of Lectures per Training</h3>
                    <canvas id="lectureChart" width="250" height="100" style="display: inline-block;"></canvas>
                </div>

                <!-- Student Card -->
                <div class="row mt-5 justify-content-center">
                    <div class="col-md-6">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="lni lni-user lni-32"></i>
                                <h5 class="card-title mt-3">Students</h5>
                                <p class="card-text">View the list of all students assigned to you.</p>
                                <button class="btn btn-primary" onclick="fetchData('https://localhost:7246/api/professor/students', 'Students')">
                                    View Students
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Display Section -->
                <div id="dataDisplay" class="mt-5">
                    <h3 class="text-center" id="sectionTitle"></h3>
                    <table class="table table-striped mt-3">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody id="dataTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
    <script>
        // Fetch and display lecture counts for each training
        async function fetchLectureCounts() {
            try {
                const response = await fetch('https://localhost:7246/api/professor/countLecture');
                if (!response.ok) throw new Error("Error fetching lecture counts");

                const data = await response.json();
                const ctx = document.getElementById('lectureChart').getContext('2d');

                // Render Chart for number of lectures per training
                new Chart(ctx, {
                    type: 'bar', // You can use other types such as 'pie', 'line', etc.
                    data: {
                        labels: data.map(training => training.trainingName), // Names of the trainings
                        datasets: [{
                            label: 'Number of Lectures',
                            data: data.map(training => training.lectureCount), // Number of lectures for each training
                            backgroundColor: '#007bff', // Color of bars
                            borderColor: '#007bff',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            x: {
                                beginAtZero: true
                            },
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 1, // Step size of 1
                                    callback: function (value) {
                                        if (Number.isInteger(value)) {
                                            return value; // Show only integer values
                                        }
                                        return null;
                                    }
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                document.getElementById("lectureChartDisplay").innerHTML =
                    `<span class="text-danger">Error: ${error.message}</span>`;
            }
        }


        // Call function to display lecture counts
        fetchLectureCounts();

        // Fetch and display student data
        async function fetchData(apiUrl, sectionTitle) {
            const tableBody = document.getElementById("dataTableBody");
            const title = document.getElementById("sectionTitle");

            title.textContent = sectionTitle;
            tableBody.innerHTML = "";

            try {
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error("Error fetching data");

                const data = await response.json();
                data.forEach(user => {
                    const row = `<tr>
                        <td>${user.id}</td>
                        <td>${user.name}</td>
                        <td>${user.userName}</td>
                        <td>${user.email}</td>
                        <td>${user.phoneNumber}</td>
                        <td>${user.role}</td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });
            } catch (error) {
                tableBody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Error: ${error.message}</td></tr>`;
            }
        }
    </script>
</body>

</html>
