@{
    ViewData["Title"] = "All Dashboard";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.lineicons.com/4.0/lineicons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    @if (User.Identity.IsAuthenticated)
    {
        @* Import Sidebar *@
        @await Html.PartialAsync("Sidebar")
        <div class="wrapper">
            <!-- Main Content Area -->
            <div class="main p-3" style="margin-left:50px; margin-top:-700px;">
                <div class="text-center">
                    <h1>@ViewData["Title"]</h1>
                </div>

                <!-- Display Statistics Section with Chart -->
                <div id="statisticsDisplay" class="mt-5 text-center">
                    <h3>User Statistics</h3>
                    <canvas id="statisticsChart" width="250" height="250" style="display: inline-block;"></canvas>
                </div>

                <!-- Card Section -->
                <div class="row mt-5">
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="lni lni-users lni-32"></i>
                                <h5 class="card-title mt-3">Admin</h5>
                                <p class="card-text">View the list of all admins.</p>
                                <button class="btn btn-primary" onclick="fetchData('https://localhost:7246/api/admins', 'Admins')">
                                    View Admin
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="lni lni-graduation lni-32"></i>
                                <h5 class="card-title mt-3">Professor</h5>
                                <p class="card-text">View the list of all professors.</p>
                                <button class="btn btn-primary" onclick="fetchData('https://localhost:7246/api/professor', 'Professor')">
                                    View Professor
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card text-center">
                            <div class="card-body">
                                <i class="lni lni-user lni-32"></i>
                                <h5 class="card-title mt-3">Students</h5>
                                <p class="card-text">View the list of all students.</p>
                                <button class="btn btn-primary" onclick="fetchData('https://localhost:7246/api/student', 'Students')">
                                    View Students
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Display Section -->
                <div id="dataDisplay" class="mt-5">
                    <h3 class="text-center" id="sectionTitle"></h3>
                    <table class="table table-striped mt-3">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Role</th>
                            </tr>
                        </thead>
                        <tbody id="dataTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ENjdO4Dr2bkBIFxQpeoTz1HIcje39Wm4jDKdf19U8gI4ddQ3GYNS7NTKfAdVQSZe" crossorigin="anonymous"></script>
    <script>
        async function fetchStatistics() {
            try {
                const response = await fetch('https://localhost:7246/api/admin/user-statistics');
                if (!response.ok) throw new Error("Error fetching statistics");

                const stats = await response.json();
                const ctx = document.getElementById('statisticsChart').getContext('2d');

                // Render Chart
                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Admins', 'Professors', 'Students'],
                        datasets: [{
                            data: [stats.admins, stats.professors, stats.student],
                            backgroundColor: ['#007bff', '#28a745', '#ffc107'],
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: false,
                        plugins: {
                            legend: {
                                position: 'top',
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        const label = context.label || '';
                                        const value = context.raw || 0;
                                        return `${label}: ${value}`;
                                    }
                                }
                            }
                        }
                    }
                });
            } catch (error) {
                document.getElementById("statisticsDisplay").innerHTML =
                    `<span class="text-danger">Error: ${error.message}</span>`;
            }
        }

        async function fetchData(apiUrl, sectionTitle) {
            const tableBody = document.getElementById("dataTableBody");
            const title = document.getElementById("sectionTitle");

            title.textContent = sectionTitle;
            tableBody.innerHTML = "";

            try {
                const response = await fetch(apiUrl);
                if (!response.ok) throw new Error("Error fetching data");

                const data = await response.json();
                data.forEach(user => {
                    const row = `<tr>
                        <td>${user.id}</td>
                        <td>${user.name}</td>
                        <td>${user.userName}</td>
                        <td>${user.email}</td>
                        <td>${user.phoneNumber}</td>
                        <td>${user.role}</td>
                    </tr>`;
                    tableBody.innerHTML += row;
                });
            } catch (error) {
                tableBody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">Error: ${error.message}</td></tr>`;
            }
        }

        fetchStatistics();
    </script>

</body>

</html>
