@model E_Learning.Data.Training
@{
    ViewData["Title"] = "Training Details";
}

<h2>@ViewData["Title"]</h2>

<div class="card shadow-lg rounded-3">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <p class="card-text">
            <strong>Assigned to:</strong> @Model.User.Name (@Model.User.Email)
        </p>
    </div>
</div>

<hr />

<h4>Uploaded Files</h4>
@if (Model.Lectures != null && Model.Lectures.Any())
{
    <ul class="list-group">
        @foreach (var file in Model.Lectures)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@file.FileName:</strong>
                    <a href="@Url.Content(file.FilePath)" target="_blank">View/Download</a>
                </div>
                @if (User.IsInRole("Professor"))
                {
                    <form method="post" action="@Url.Action("DeleteLecture", "Lecture", new { id = file.Id })" onsubmit="return confirm('Are you sure you want to delete this lecture?');" class="ms-3">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                }
            </li>
        }
    </ul>
}
else
{
    <p>No files uploaded yet.</p>
}

<hr />

@if (User.IsInRole("Professor"))
{
    <h4>Upload a New File</h4>
    <form method="post" enctype="multipart/form-data" action="@Url.Action("UploadFile", "Training", new { id = Model.Id })">
        <div class="form-group">
            <label for="fileInput">Select a Word or PowerPoint file:</label>
            <input type="file" name="file" class="form-control" id="fileInput" accept=".doc,.docx,.ppt,.pptx" required>
        </div>
        <button type="submit" class="btn btn-primary mt-3">Upload File</button>
    </form>
}

<script>
    // Log the result of User.IsInRole("Professor") to the browser console
    var isProfessor = @User.IsInRole("Professor").ToString().ToLower();
    console.log("Is user a Professor? " + isProfessor);
</script>
<a href="https://localhost:7246/training/index" class="btn btn-secondary mt-3">Back to List</a>
