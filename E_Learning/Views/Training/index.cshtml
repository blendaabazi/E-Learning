@using E_Learning.Data
@{
    ViewData["Title"] = "Training List";
    var trainingsJson = System.Text.Json.JsonSerializer.Serialize<IEnumerable<Training>>(Model);
    var usersJson = System.Text.Json.JsonSerializer.Serialize<List<ApplicationUser>>((List<ApplicationUser>)ViewBag.Users);
}

<h2>@ViewData["Title"]</h2>

@if (User.IsInRole("Admin"))
{
    <!-- Button for adding new training, opens modal -->
    <button class="btn btn-success custom-edit-btn" data-bs-toggle="modal" data-bs-target="#addTrainingModal">Add New Training</button>
}

<div id="training-list" class="row"></div>

<!-- Modal for adding new training -->
<div class="modal fade" id="addTrainingModal" tabindex="-1" aria-labelledby="addTrainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTrainingModalLabel">Add New Training</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="add-training-form">
                    <div class="mb-3">
                        <label for="name" class="form-label">Training Name:</label>
                        <input type="text" id="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="userId" class="form-label">Assign to User:</label>
                        <select id="userId" class="form-select" required>
                            <option value="">Select User</option>
                            @foreach (var user in ViewBag.Users as List<ApplicationUser>)
                            {
                                <option value="@user.Id">@user.Name</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Training</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal for editing training -->
<div class="modal fade" id="editTrainingModal" tabindex="-1" aria-labelledby="editTrainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTrainingModalLabel">Edit Training</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="edit-training-form">
                    <div class="mb-3">
                        <label for="edit-name" class="form-label">Training Name:</label>
                        <input type="text" id="edit-name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="edit-userId" class="form-label">Assign to User:</label>
                        <select id="edit-userId" class="form-select" required>
                            <option value="">Select User</option>
                            @foreach (var user in ViewBag.Users as List<ApplicationUser>)
                            {
                                <option value="@user.Id">@user.Name</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" id="edit-id" />
                    <button type="submit" class="btn btn-primary">Update Training</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const apiUrl = 'https://localhost:7246/api/training';  // Define API URL

        // Fetch training data (GET request)
        function fetchTrainings() {
            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    const trainingListDiv = document.getElementById('training-list');
                    const listHtml = data.map(training =>
                        `<div class="col-md-4 mb-4">
                                 <a href="https://localhost:7246/training/Details/${training.id}" class="text-decoration-none">
                                            <div class="card shadow-lg rounded-3">
                                                <img src="${training.filePath || 'https://via.placeholder.com/300x200.png?text=E-Learning'}"
                                                     class="card-img-top rounded-top" alt="Training Image">
                                                <div class="card-body">
                                                            <h5 class="card-title">
                                                <a href="https://localhost:7246/training/Details/${training.id}" class="text-decoration-none">${training.name}</a>
            </h5>
                                                    <p class="card-text"><strong>Assigned to:</strong> ${training.name}</p> 
                                                    </a>
                                                 
                                                    @if (User.IsInRole("Admin"))
                                                    {
                                                        <button class="btn custom-edit-btn" onclick="editTraining(${training.id}, '${training.name}', '${training.userId}')">Edit</button>
                                                        <button class="btn btn-danger" onclick="deleteTraining(${training.id})">Delete</button>
                                                    }
                                                </div>
                                            </div>
                                        </div>`).join('');
                    trainingListDiv.innerHTML = listHtml;
                })
                .catch(error => alert('Error fetching training data: ' + error.message));
        }

        // Add a new training (POST request)
        document.getElementById('add-training-form').addEventListener('submit', function (e) {
            e.preventDefault();

            const name = document.getElementById('name').value;
            const userId = document.getElementById('userId').value;

            const newTraining = {
                name: name,
                userId: userId
            };

            fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newTraining)
            })
                .then(response => {
                    if (response.ok) {
                        alert('Training added successfully!');
                        fetchTrainings(); // Refresh the list
                        document.getElementById('add-training-form').reset(); // Reset the form
                    } else {
                        alert('Failed to add training.');
                    }
                })
                .catch(error => alert('Error adding training: ' + error.message));
        });

        // Edit an existing training (PUT request)
        function editTraining(id, currentName, currentUserId) {
            document.getElementById('edit-id').value = id;  // Set the training ID
            document.getElementById('edit-name').value = currentName;  // Set the training name
            document.getElementById('edit-userId').value = currentUserId;  // Set the user ID

            // Show the modal
            const editModal = new bootstrap.Modal(document.getElementById('editTrainingModal'));
            editModal.show();

            // Submit the updated training data
            document.getElementById('edit-training-form').onsubmit = function (e) {
                e.preventDefault();

                const updatedTraining = {
                    id: id,
                    name: document.getElementById('edit-name').value,
                    userId: document.getElementById('edit-userId').value
                };

                fetch(`${apiUrl}/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updatedTraining)
                })
                    .then(response => {
                        if (response.ok) {
                            alert("Training updated successfully!");
                            fetchTrainings(); // Refresh the list
                            const modal = bootstrap.Modal.getInstance(document.getElementById('editTrainingModal'));
                            modal.hide(); // Close modal after successful update
                        } else {
                            alert("Failed to update training.");
                        }
                    })
                    .catch(error => alert('Error updating training: ' + error.message));
            };
        }

        // Delete a training (DELETE request)
        function deleteTraining(id) {
            const confirmDelete = confirm("Are you sure you want to delete this training?");

            if (confirmDelete) {
                fetch(`${apiUrl}/${id}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            alert('Training deleted successfully!');
                            fetchTrainings(); // Refresh the list
                        } else {
                            alert('Failed to delete training.');
                        }
                    })
                    .catch(error => alert('Error deleting training: ' + error.message));
            }
        }

        // Initialize and fetch the training list on page load
        document.addEventListener('DOMContentLoaded', fetchTrainings);
    </script>

    <style>
        .custom-edit-btn {
            background-color: #4DB8FF !important;
            color: white;
            margin-bottom: 5px;
            transition: background-color 0.3s ease;
        }

        .custom-edit-btn:hover {
            background-color: #3a9cd6 !important;
        }

        .card {
            border: none;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card-img-top {
            height: 100px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .card-body {
            padding: 20px;
        }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .card:hover .card-img-top {
            transform: scale(1.1);
        }
    </style>
}
