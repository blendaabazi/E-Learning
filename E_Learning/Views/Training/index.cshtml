@using E_Learning.Data
@{
    ViewData["Title"] = "Training List";
    var trainingsJson = System.Text.Json.JsonSerializer.Serialize<IEnumerable<Training>>(Model);
    var usersJson = System.Text.Json.JsonSerializer.Serialize<List<ApplicationUser>>((List<ApplicationUser>)ViewBag.Users);
}

<h2>@ViewData["Title"]</h2>

<!-- Div për alarmin -->
<div id="alert" class="alert-custom"></div>

@if (User.IsInRole("Admin"))
{
    <!-- Button for adding new training, opens modal -->
    <button class="btn btn-success custom-edit-btn" data-bs-toggle="modal" data-bs-target="#addTrainingModal">Add New Training</button>
}

<div id="training-list" class="row"></div>

<!-- Modal for adding new training -->
<div class="modal fade" id="addTrainingModal" tabindex="-1" aria-labelledby="addTrainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addTrainingModalLabel">Add New Training</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="add-training-form">
                    <div class="mb-3">
                        <label for="name" class="form-label">Training Name:</label>
                        <input type="text" id="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="userId" class="form-label">Assign to User:</label>
                        <select id="userId" class="form-select" required>
                            <option value="">Select User</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Training</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal for editing training -->
<div class="modal fade" id="editTrainingModal" tabindex="-1" aria-labelledby="editTrainingModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editTrainingModalLabel">Edit Training</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="edit-training-form">
                    <div class="mb-3">
                        <label for="edit-name" class="form-label">Training Name:</label>
                        <input type="text" id="edit-name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="edit-userId" class="form-label">Assign to User:</label>
                        <select id="edit-userId" class="form-select" required>
                         
                            @foreach (var user in ViewBag.Users as List<ApplicationUser>)
                            {
                                <option value="@user.Id">@user.Name</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" id="edit-id" />
                    <button type="submit" class="btn btn-primary">Update Training</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const apiUrl = 'https://localhost:7246/api/training';  // Define API URL

        // Fetch training data (GET request)
        function fetchTrainings() {
            fetch(apiUrl)
                .then(response => response.json())
                .then(data => {
                    const trainingListDiv = document.getElementById('training-list');
                    const listHtml = data.map(training =>
                        `<div class="col-md-4 mb-4">
                                 <a href="https://localhost:7246/training/Details/${training.id}" class="text-decoration-none">
                                            <div class="card shadow-lg rounded-3">
                                                <img src="${training.filePath || 'https://via.placeholder.com/300x200.png?text=E-Learning'}"
                                                     class="card-img-top rounded-top" alt="Training Image">
                                                <div class="card-body">
                                                            <h5 class="card-title">
                                                <a href="https://localhost:7246/training/Details/${training.id}" class="text-decoration-none">${training.name}</a>
                                                </h5>
                                                    <p class="card-text"><strong>Assigned to:</strong> ${training.name}</p>
                                                    </a>

        @if (User.IsInRole("Admin"))
        {
                                                            <button class="btn custom-edit-btn" onclick="editTraining(${training.id}, '${training.name}', '${training.userId}')">Edit</button>
                                                            <button class="btn btn-danger" onclick="deleteTraining(${training.id})">Delete</button>
        }
                                                </div>
                                            </div>
                                        </div>`).join('');
                    trainingListDiv.innerHTML = listHtml;
                })
                .catch(error => showAlert('Error fetching training data: ' + error.message, 'error'));
        }

        // Add a new training (POST request)
        document.getElementById('add-training-form').addEventListener('submit', function (e) {
            e.preventDefault();

            const name = document.getElementById('name').value;
            const userId = document.getElementById('userId').value;

            const newTraining = {
                name: name,
                userId: userId
            };

            fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(newTraining)
            })
                .then(response => {
                    if (response.ok) {
                        showAlert('Training added successfully!', 'success');
                        fetchTrainings(); // Refresh the list
                         const modal = bootstrap.Modal.getInstance(document.getElementById('addTrainingModal'));
                          modal.hide();
                         location.reload();
                    } else {
                        showAlert('Failed to add training.', 'error');
                    }
                })
                .catch(error => showAlert('Error adding training: ' + error.message, 'error'));
        });

        // Edit an existing training (PUT request)
        function editTraining(id, currentName, currentUserId) {
            document.getElementById('edit-id').value = id;  // Set the training ID
            document.getElementById('edit-name').value = currentName;  // Set the training name
            document.getElementById('edit-userId').value = currentUserId;  // Set the user ID

            // Show the modal
            const editModal = new bootstrap.Modal(document.getElementById('editTrainingModal'));
            editModal.show();

            // Submit the updated training data
            document.getElementById('edit-training-form').onsubmit = function (e) {
                e.preventDefault();

                const updatedTraining = {
                    id: id,
                    name: document.getElementById('edit-name').value,
                    userId: document.getElementById('edit-userId').value
                };

                fetch(`${apiUrl}/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(updatedTraining)
                })
                    .then(response => {
                        if (response.ok) {
                            showAlert('Training updated successfully!', 'success');
                            fetchTrainings(); // Refresh the list
                            const modal = bootstrap.Modal.getInstance(document.getElementById('editTrainingModal'));
                            modal.hide(); // Close modal after successful update
                        } else {
                            showAlert('Failed to update training.', 'error');
                        }
                    })
                    .catch(error => showAlert('Error updating training: ' + error.message, 'error'));
            };
        }

        // Delete a training (DELETE request)
        function deleteTraining(id) {
            const confirmDelete = confirm("Are you sure you want to delete this training?");

            if (confirmDelete) {
                fetch(`${apiUrl}/${id}`, {
                    method: 'DELETE'
                })
                    .then(response => {
                        if (response.ok) {
                            showAlert('Training deleted successfully!', 'success');
                            fetchTrainings(); // Refresh the list
                        } else {
                            showAlert('Failed to delete training.', 'error');
                        }
                    })
                    .catch(error => showAlert('Error deleting training: ' + error.message, 'error'));
            }
        }

        // Function to show alerts
        function showAlert(message, type) {
            const alertBox = document.getElementById('alert');
            alertBox.textContent = message;  // Set the message
            alertBox.className = `alert-custom alert-${type} alert-show`;  // Add the corresponding class (success, error, etc.)

            // Hide the alert after a few seconds
            setTimeout(function() {
                alertBox.classList.remove('alert-show');
            }, 5000);  // Hide after 3 seconds
        }

        // Initialize and fetch the training list on page load
        document.addEventListener('DOMContentLoaded', fetchTrainings);
    </script>

    <style>
        /* Stilimi i alarmeve */
        .alert-custom {
            padding: 15px;
            border-radius: 5px;
            margin: 10px 0;
            font-size: 16px;
            font-weight: bold;
            color: #fff;
            display: none; /* Fillimisht fsheh alarmin */
            transition: opacity 0.5s ease-in-out;
        }

        /* Alarm për sukses (green) */
        .alert-success {
            background-color: #28a745;
        }

        /* Alarm për gabim (red) */
        .alert-error {
            background-color: #dc3545;
        }

        /* Alarm për informacion (blue) */
        .alert-info {
            background-color: #17a2b8;
        }

        /* Alarm për paralajmërim (yellow) */
        .alert-warning {
            background-color: #ffc107;
        }

        .alert-show {
            display: block;
            opacity: 1;
        }

        .custom-edit-btn {
            background-color: #4DB8FF !important;
            color: white;
            margin-bottom: 5px;
            transition: background-color 0.3s ease;
        }

            .custom-edit-btn:hover {
                background-color: #3a9cd6 !important;
            }

        .card {
            border: none;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .card-img-top {
            height: 100px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .card-body {
            padding: 20px;
        }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

            .card:hover .card-img-top {
                transform: scale(1.1);
            }

        #training-list{
            margin-left:30px;
        }
    </style>
    <script>
    // Fetch professors from the API
        // Fetch professors from the API
        // Fetch professors from the API
        async function fetchProfessors() {
            try {
                const response = await fetch('/api/professor'); // Make sure this returns the right data
                const users = await response.json();

                const userSelect = document.getElementById('userId');

                // Clear existing options
                userSelect.innerHTML = '<option value="">Select Professor</option>';

                // Filter the users to include only those with the role "Professor"
                const professors = users.filter(user => user.role === 'Professor');

                // Check if there are professors
                if (professors.length > 0) {
                    // Populate the dropdown with professor users
                    professors.forEach(professor => {
                        const option = document.createElement('option');
                        option.value = professor.id;  // The ID will be the value of the option
                        option.textContent = professor.name;  // The professor's name will be shown in the dropdown
                        userSelect.appendChild(option);
                    });
                } else {
                    // No need for an alert, you can log it or handle differently
                    console.log('No professors found.');
                }
            } catch (error) {
                console.error('Error fetching professors:', error);
            }
        }

        // Call the function when the page loads
        document.addEventListener('DOMContentLoaded', fetchProfessors);


    document.addEventListener('DOMContentLoaded', fetchProfessors);
</script>
}

