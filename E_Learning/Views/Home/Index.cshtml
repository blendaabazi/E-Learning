@using E_Learning.Data
@{
    ViewData["Title"] = "Home Page";
    ViewData["CurrentPage"] = "Home Page";
    var trainingsJson = System.Text.Json.JsonSerializer.Serialize<IEnumerable<Training>>(Model);
}

@* Import Sidebar *@
@await Html.PartialAsync("Sidebar")

<!-- Link për Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Link për Bootstrap JS (Bundle përfshin Popper.js dhe Bootstrap JS) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>

<div class="content">

    

    @if (User.Identity.IsAuthenticated)
    {
        <section id="latest-trainings" class="section my-5">
            <h2 style="margin:-300px" class="text-center">Latest Trainings</h2>
            <div class="row justify-content-center" id="training-list">
                <!-- Trajnimet do të shfaqen këtu -->
            </div>
        </section>
    }

    @if (!User.Identity.IsAuthenticated)
    {
        <!-- Carousel Section -->
        <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">
            <ol class="carousel-indicators">
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"></li>
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"></li>
                <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"></li>
            </ol>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="images/slider/foto.png" alt="First slide" class="d-block w-100">
                </div>
                <div class="carousel-item">
                    <img src="images/slider/foto.jpg" alt="Second slide" class="d-block w-100">
                </div>
                <div class="carousel-item">
                    <img src="images/slider/foto1.png" alt="Third slide" class="d-block w-100">
                </div>
            </div>
            <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </a>
            <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </a>
        </div>

        <!-- Courses Section -->
        <section id="courses" class="section my-5">
            <h2 class="text-center">Our Courses</h2>
            <p class="text-center">Explore a wide variety of courses that are designed to help you learn and grow professionally.</p>
            <div class="course-list row justify-content-center">
                <div class="course-item col-12 col-md-4 text-center mb-4">
                    <h3>Java</h3>
                    <p>If you want to view the course please login</p>
                </div>
                <div class="course-item col-12 col-md-4 text-center mb-4">
                    <h3>Python</h3>
                    <p>If you want to view the course please login.</p>
                </div>
                <div class="course-item col-12 col-md-4 text-center mb-4">
                    <h3>React Js</h3>
                    <p>If you want to view the course please login.</p>
                </div>
            </div>
        </section>
    }

    <!-- About Us Section -->
    <section id="about-us" class="section my-5">
        <h2 class="text-center">About Us</h2>
        <p class="text-center">We provide an accessible and flexible learning platform, helping students to achieve their educational goals at their own pace and convenience.</p>
    </section>

    <!-- Contact Us Section -->
    <section id="contact-us" class="section my-5">
        <h2 class="text-center">Contact Us</h2>
        <p class="text-center">Have any questions or need support? Get in touch with our team!</p>
        <ul class="list-unstyled text-center">
            <li>Email: <a href="mailto:support@elearning.com">support@elearning.com</a></li>
            <li>Phone: <a href="tel:+1234567890">123-456-7890</a></li>
        </ul>
    </section>

    <!-- Footer -->
 
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const apiUrl = 'https://localhost:7246/api/training/latest';  // Define API URL

        // Fetch training data (GET request)
        function fetchTrainings() {
            axios.get(apiUrl)
                .then(response => {
                    console.log(response.data);  // Shihni të dhënat që kthehen
                    const trainingListDiv = document.getElementById('training-list');
                    const listHtml = response.data.map(training =>
                        `<div class="col-md-4 mb-4">
                                             <a href="https://localhost:7246/training/Details/${training.id}" class="text-decoration-none">
                                                <div class="card shadow-lg rounded-3">
                                                    <img src="${training.filePath || 'https://via.placeholder.com/300x200.png?text=E-Learning'}"
                                                         class="card-img-top rounded-top" alt="Training Image">
                                                    <div class="card-body">
                                                        <h5 class="card-title">${training.name}</h5>
                                                        <p class="card-text"><strong>Assigned to:</strong> ${training.name}</p>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>`).join('');
                    trainingListDiv.innerHTML = listHtml;
                })
                .catch(error => console.error('Error fetching training data:', error));
        }

        // Thirrja e funksionit kur faqja është ngarkuar
        document.addEventListener('DOMContentLoaded', function () {
            fetchTrainings();
        });
    </script>
}
<style>
    .content{
        margin-left:50px;
    }
    /* Rregullo seksionin që përmban trajnimet */
    #latest-trainings {
        margin-top: -50px; /* Lëviz seksionin më lart */
        padding-top: 20px; /* Sigurohuni që ka mjaft hapësirë brenda seksionit */
    }

    /* Shtoni ndonjë stil tjetër që mund të nevojitet për paraqitjen */
    #training-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .card {
        width: 100%;
        max-width: 300px;
        margin: 10px;
    }

    .card-img-top {
        height: 200px;
        object-fit: cover;
    }
</style>



