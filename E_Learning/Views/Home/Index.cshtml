@{
    ViewData["Title"] = "Home Page";
}

@* Import Sidebar *@
@await Html.PartialAsync("Sidebar")
<!-- Link për Bootstrap CSS -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

<!-- Link për jQuery -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>


<!-- Link për Bootstrap JS -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>


<div class="content" style="padding: 20px;">


    <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="images/home/student.png" alt="First slide">
            </div>
            <div class="carousel-item">
                <img src="images/home/logo.png" alt="Second slide">
            </div>
            <div class="carousel-item">
                <img src="images/home/pattern.png" alt="Third slide">
            </div>
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>

    <section id="about-us" class="section">
        <h2>About Us</h2>
        <p>We provide an accessible and flexible learning platform, helping students to achieve their educational goals at their own pace and convenience.</p>
    </section>

    <!-- Contact Us Section -->
    <section id="contact-us" class="section">
        <h2>Contact Us</h2>
        <p>Have any questions or need support? Get in touch with our team!</p>
        <ul>
            <li>Email: support@elearning.com</li>
            <li>Phone: 123-456-7890</li>
        </ul>
    </section>

    <!-- Courses Section -->
    <section id="courses" class="section">
        <h2>Our Courses</h2>
        <p>Explore a wide variety of courses that are designed to help you learn and grow professionally.</p>
        <div class="course-list">
            <div class="course-item">
                <h3>Course 1</h3>
                <p>A brief description of Course 1.</p>
            </div>
            <div class="course-item">
                <h3>Course 2</h3>
                <p>A brief description of Course 2.</p>
            </div>
            <div class="course-item">
                <h3>Course 3</h3>
                <p>A brief description of Course 3.</p>
            </div>
        </div>
    </section>

</div>

<!-- Footer -->
<footer>
    <p>&copy; 2024 E-Learning Platform. All Rights Reserved.</p>
</footer>

<!-- Add JavaScript for slider -->
<script>
    let currentSlideIndex = 0;

    function showSlides() {
        let slides = document.querySelectorAll('.slide');
        for (let i = 0; i < slides.length; i++) {
            slides[i].style.display = 'none';  // Hide all slides
        }

        currentSlideIndex++;
        if (currentSlideIndex > slides.length) { currentSlideIndex = 1 } // Reset to first slide if it exceeds the total
        slides[currentSlideIndex - 1].style.display = 'block';  // Show the current slide
    }

    // Set interval to show the next slide every 2 seconds (2000 ms)
    setInterval(showSlides, 2000);

    // Initially show the first slide
    showSlides();
</script>

