@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS për stilizim -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        /* Stilizimi për contentin vetëm */
        .content-container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background-color: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            max-width: 400px;
            width: 100%;
            margin-top: 50px;
            margin-left:450px;
        }

            /* Butonat që janë në content-container */
            .content-container .btn {
                font-size: 16px;
                padding: 10px 20px;
                margin: 10px;
                width: 100%;
            }

            .content-container .btn-secondary {
                background-color: #6c757d;
                border-color: #6c757d;
            }

            .content-container .btn-danger {
                background-color: #dc3545;
                border-color: #dc3545;
            }

            .content-container .btn:hover {
                opacity: 0.9;
            }

            /* Stil për tituj dhe paragrafë në content-container */
            .content-container h1 {
                color: #333;
            }

            .content-container p {
                color: #555;
            }
    </style>
</head>
<body>
    <header >
        <h1 style=" text-align:center;">@ViewData["Title"]</h1>
    </header>

    <div class="content-container">
        @if (User.Identity.IsAuthenticated)
        {
            <p>Are you sure you want to log out?</p>

            <!-- Butoni për të anuluar dhe për të mbetur në faqen aktuale -->
            <a href="/" class="btn btn-secondary">Cancel</a>

            <!-- Butoni për të konfirmuar dhe ekzekutuar logout -->
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                <button type="submit" class="btn btn-danger">Confirm Logout</button>
            </form>
        }
        else
        {
            <p>You have successfully logged out of the application.</p>
        }
    </div>

    <footer>
        <!-- Footer content -->
    </footer>

    <!-- Bootstrap JS për funksionalitet të mëtejshëm -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
